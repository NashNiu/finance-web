# Base URL the frontend uses to reach the backend API.
#
# Local dev (.env): point directly at the dev backend.
VITE_API_BASE_URL=http://localhost:3000/api
#
# Production is handled by .env.production (committed), which sets this to the
# relative path "/api" so requests stay same-origin and nginx proxies them to
# the backend. You normally don't need to change that for the nginx deploy.
